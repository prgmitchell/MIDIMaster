{
  "bundle": {
    "createUpdaterArtifacts": false,
    "windows": {
      "signCommand": {
        "cmd": "pwsh",
        "args": [
          "-NoLogo",
          "-NoProfile",
          "-NonInteractive",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "../scripts/release/Sign-WithArtifactSigning.ps1",
          "%1"
        ]
      }
    }
  }
}
